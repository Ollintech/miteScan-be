# --- Configuração do Banco de Dados ---
# Exemplo para PostgreSQL local: postgresql://user:password@localhost:5432/dbname
# Exemplo para Supabase: postgres://postgres:[SUA-SENHA]@[HOST-DO-SUPABASE]:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/mitescan"

# --- Configuração de Autenticação (JWT) ---
SECRET_KEY=sua_chave_secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Configuração do MQTT ---
# Endereço do broker MQTT (pode ser um IP local ou um serviço público como broker.hivemq.com)
MQTT_BROKER="broker.hivemq.com"
MQTT_PORT=1883
# Tópico para escutar os dados dos sensores. O '#' é um coringa para todos os sub-tópicos.
MQTT_TOPIC="colmeia/#"

# --- URL da API interna para o MQTT Handler ---
API_SENSOR_URL=http://localhost:8000/sensors

# --- Web Push Notifications (Desktop / Navegador) ---
VAPID_PUBLIC_KEY="BJT6J1A3F5CQNvey1mjx_1N6-PABFDnHaVRxYNSwr-gMwBeQZ-wGOTKR71LiWx-csDqC33r71_r3GJJeH65M7BU"
VAPID_PRIVATE_KEY="aD1_eqxzz1Z74XD_duGZm3DpwL0K1ULvcOE7DP36RhQ"
VAPID_CLAIMS_EMAIL="mailto:admin@mitescan.com"

# --- Limiares de Alerta de Temperatura e Umidade ---
TEMP_MIN_ALERT=20.0
TEMP_MAX_ALERT=29.0
HUMIDITY_MIN_ALERT=45.0
HUMIDITY_MAX_ALERT=80.0
